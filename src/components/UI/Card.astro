---
export interface Props {
  title: string;
  image?: {
    src: string;
    alt: string;
  };
  dataSeries?: string;
  dataSpeaker?: string;
  dataDate?: string;
  href?: string;
  className?: string;
  imageLayout?: 'top' | 'background';
}

const { title, image, href, className = "", imageLayout = 'top', dataSeries, dataSpeaker, dataDate} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const withBase = (url?: string) => {
  if (!url) return url;
  if (
    /^(?:[a-z]+:)?\/\//i.test(url) ||
    url.startsWith("#") ||
    url.startsWith("mailto:") ||
    url.startsWith("tel:")
  ) {
    return url;
  }
  if (base && (url === base || url.startsWith(`${base}/`))) return url;
  return url.startsWith("/") ? `${base}${url}` : url;
};
const normalizedHref = withBase(href);
const normalizedImage = image ? { ...image, src: withBase(image.src) ?? image.src } : image;
const Element = href ? "a" : "div";
---

<Element
  href={normalizedHref}
  aria-label={href ? title : undefined}
  data-series={dataSeries}
  data-speaker={dataSpeaker}
  data-date={dataDate}
  class:list={[
    'card group overflow-hidden',
    { 'relative': imageLayout === 'background' },
    className
  ]}
>
  {image && (
    <div class:list={[
      'overflow-hidden',
      { 'absolute inset-0': imageLayout === 'background' }
    ]}>
      <img
        src={normalizedImage?.src}
        alt={normalizedImage?.alt}
        class:list={[
          "w-full object-cover object-center transition-transform duration-300 group-hover:scale-105",
          { 'h-full': imageLayout === 'background', 'h-auto': imageLayout === 'top' }
        ]}
      />
    </div>
  )}

  <div class:list={[
    'p-5',
    { 'relative': imageLayout === 'background' }
  ]}>
    <h3 class="mb-2 text-xl font-bold">{title}</h3>
    <div class="text-gray-700">
      <slot />
    </div>
  </div>
</Element>
